# Email delivery for Food Rescue sign-in and password recovery codes.
# Resend is preferred on hosts that block SMTP. Verify the sender domain first.
RESEND_API_KEY=
# Existing Brevo integration remains available as a fallback.
BREVO_API_KEY=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM="Food Rescue <otp@your-verified-domain.example>"

# One-time sign-in codes expire after 10 minutes by default.
LOGIN_OTP_TTL_MS=600000
# Sign-in OTP is paused by default; set true to re-enable email codes.
LOGIN_OTP_ENABLED=false

# MySQL-compatible production database (for example, TiDB Cloud Starter).
DB_HOST=your-database-host
DB_PORT=4000
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=foodbridge
DB_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
NGO_MATCH_RADIUS_KM=35

# The only administrator account. Set a unique, strong password in deployment.
ADMIN_EMAIL=admin.org@gmail.com
ADMIN_PASSWORD=replace-with-a-long-random-password
